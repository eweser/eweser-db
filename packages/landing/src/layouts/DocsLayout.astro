---
import Layout from './Layout.astro';
import { DOCS_NAV, DOCS_URLS } from '../lib/docs-nav';

interface Props {
  title: string;
  description: string;
  heading: string;
  standfirst: string;
}

const { title, description, heading, standfirst } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/docs';
---

<Layout title={title} description={description}>
  <div class="flex min-h-screen flex-col bg-white">
    <header class="border-b border-slate-200 bg-white px-6 py-5">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-6">
        <a href="/" class="flex items-center gap-3">
          <img
            src="/eweser-logo.svg"
            alt=""
            aria-hidden="true"
            class="h-8 w-8"
          />
          <span class="text-lg font-semibold tracking-tight text-slate-950"
            >EweserDB</span
          >
        </a>
        <nav
          class="hidden items-center gap-6 text-sm font-medium text-slate-600 md:flex"
        >
          <a href="/" class="transition-colors hover:text-slate-950">Home</a>
          <a href="/docs" class="text-slate-950">Docs</a>
          <a
            href={DOCS_URLS.note}
            class="transition-colors hover:text-slate-950">Ewe Note</a
          >
          <a
            href={DOCS_URLS.developerDocs}
            target="_blank"
            rel="noreferrer"
            class="transition-colors hover:text-slate-950">Developer docs</a
          >
        </nav>
      </div>
    </header>

    <main class="bg-white text-slate-900">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-12 px-6 py-14 lg:flex-row lg:gap-16 lg:py-20"
      >
        <nav
          aria-label="Documentation"
          class="lg:sticky lg:top-12 lg:h-fit lg:w-64 lg:shrink-0"
        >
          <p
            class="text-xs font-semibold uppercase tracking-[0.28em] text-[#d62d20]"
          >
            Docs
          </p>
          <ul class="mt-4 space-y-1 text-sm">
            {
              DOCS_NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={
                      currentPath === item.href ? 'page' : undefined
                    }
                    class:list={[
                      'block rounded-lg px-3 py-2 transition-colors',
                      currentPath === item.href
                        ? 'bg-[#f5f2ec] font-semibold text-slate-950'
                        : 'text-slate-600 hover:bg-slate-50 hover:text-slate-950',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <article class="min-w-0 flex-1">
          <h1
            class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl"
          >
            {heading}
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">
            {standfirst}
          </p>
          <div class="docs-prose mt-10 max-w-2xl">
            <slot />
          </div>
        </article>
      </div>
    </main>

    <footer
      class="border-t border-slate-200 bg-white px-6 py-10 text-slate-600"
    >
      <div
        class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 md:flex-row"
      >
        <div class="flex items-center gap-2">
          <img
            src="/eweser-logo.svg"
            alt=""
            aria-hidden="true"
            class="h-6 w-6"
          />
          <span class="font-semibold tracking-tight text-slate-950"
            >EweserDB</span
          >
        </div>
        <div
          class="flex flex-wrap items-center justify-center gap-6 text-sm font-medium"
        >
          <a href="/docs" class="transition-colors hover:text-slate-950">Docs</a
          >
          <a
            href="/connected-tools"
            class="transition-colors hover:text-slate-950">Connected tools</a
          >
          <a
            href={DOCS_URLS.note}
            class="transition-colors hover:text-slate-950">Ewe Note</a
          >
          <a
            href={DOCS_URLS.github}
            target="_blank"
            rel="noreferrer"
            class="transition-colors hover:text-slate-950">GitHub</a
          >
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  .docs-prose h2 {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: rgb(2 6 23);
  }

  .docs-prose h3 {
    margin-top: 2rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: rgb(2 6 23);
  }

  .docs-prose p,
  .docs-prose ul,
  .docs-prose ol {
    margin-top: 1rem;
    line-height: 1.7;
    color: rgb(71 85 105);
  }

  .docs-prose ul {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .docs-prose ol {
    list-style: decimal;
    padding-left: 1.25rem;
  }

  .docs-prose li + li {
    margin-top: 0.4rem;
  }

  .docs-prose a {
    color: rgb(2 6 23);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .docs-prose code {
    border-radius: 0.375rem;
    background: rgb(245 242 236);
    padding: 0.1rem 0.35rem;
    font-size: 0.9em;
  }

  .docs-prose pre {
    margin-top: 1rem;
    overflow-x: auto;
    border-radius: 0.75rem;
    background: rgb(15 23 42);
    padding: 1rem 1.25rem;
    color: rgb(226 232 240);
  }

  .docs-prose pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .docs-prose table {
    margin-top: 1.25rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.925rem;
  }

  .docs-prose th,
  .docs-prose td {
    border: 1px solid rgb(226 232 240);
    padding: 0.55rem 0.75rem;
    text-align: left;
    vertical-align: top;
    color: rgb(71 85 105);
  }

  .docs-prose th {
    background: rgb(248 250 252);
    font-weight: 600;
    color: rgb(2 6 23);
  }

  .docs-callout {
    margin-top: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(226 232 240);
    background: rgb(245 242 236);
    padding: 1rem 1.25rem;
  }

  .docs-callout p {
    margin-top: 0;
  }

  .docs-next {
    margin-top: 3rem;
    border-top: 1px solid rgb(226 232 240);
    padding-top: 1.5rem;
    font-size: 0.925rem;
  }
</style>
